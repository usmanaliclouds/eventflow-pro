# Copy to your hosting provider's environment settings. Never commit real values.
PORT=4000
NODE_ENV=production
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# 1 = show the one-time code on screen (no SMS provider). 0 = hide it.
OTP_DEMO=1
# Folder for the SQLite file (use a persistent disk in production)
DATA_DIR=./data
